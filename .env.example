# ── ESPN credentials ──────────────────────────────────────────────────────────
# In a browser logged into ESPN Fantasy: DevTools → Application → Cookies → espn.com
# Copy the SWID and espn_s2 values. These ARE your login — never commit them.
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_S2=

# Season to operate on. Defaults to the current NFL season.
ESPN_SEASON=2026

# ── Your leagues ──────────────────────────────────────────────────────────────
# Format: leagueId:teamId:Label   (comma-separated, one entry per league)
# Append ":manual" to make a league propose-only instead of full auto, and
# ":lastplace" to show last-place odds instead of title odds (flags combine).
# Run `npm run verify` to list every team id in every league.
ESPN_LEAGUES=123456:1:Main League,234567:4:Work League,345678:8:Dynasty

# ── Optional ──────────────────────────────────────────────────────────────────
# A FantasyPros key gives a stable expert-consensus feed instead of page scraping.
FANTASYPROS_API_KEY=

# Required only if you expose the cron endpoint publicly.
CRON_SECRET=
